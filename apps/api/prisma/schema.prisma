generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BoardRole {
  OWNER
  MEMBER
}

model User {
  id              String         @id @default(cuid())
  fullName        String
  email           String         @unique
  passwordHash    String
  createdAt       DateTime       @default(now())
  memberships     BoardMember[]
  createdBoards   Board[]        @relation("CreatedBoards")
  createdCards    Card[]         @relation("CreatedCards")
  assignedCards   Card[]         @relation("AssignedCards")
  activityEvents  ActivityEvent[]

  @@map("users")
}

model Board {
  id          String          @id @default(cuid())
  name        String
  createdBy   User            @relation("CreatedBoards", fields: [createdById], references: [id])
  createdById String
  members     BoardMember[]
  columns     Column[]
  cards       Card[]
  activity    ActivityEvent[]
  createdAt   DateTime        @default(now())

  @@map("boards")
}

model BoardMember {
  id       String    @id @default(cuid())
  board    Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId  String
  user     User      @relation(fields: [userId], references: [id])
  userId   String
  role     BoardRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([boardId, userId])
  @@map("board_members")
}

model Column {
  id        String   @id @default(cuid())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId   String
  name      String
  position  Float
  cards     Card[]
  createdAt DateTime @default(now())

  @@index([boardId])
  @@map("columns")
}

model Card {
  id          String   @id @default(cuid())
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId     String
  column      Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  columnId    String
  title       String
  description String?
  position    Float
  assignee    User?    @relation("AssignedCards", fields: [assigneeId], references: [id])
  assigneeId  String?
  createdBy   User     @relation("CreatedCards", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([columnId])
  @@index([boardId])
  @@map("cards")
}

model ActivityEvent {
  id        String   @id @default(cuid())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId   String
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  message   String
  createdAt DateTime @default(now())

  @@index([boardId])
  @@map("activity_events")
}
